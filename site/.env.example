# ─── Required ────────────────────────────────────────────────────────────────
# The only variable you actually need to run locally. Everything below degrades
# gracefully: no Supabase means in-memory storage, no Upstash means in-memory
# rate limits, no Turnstile secret means the captcha check is skipped.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Spend caps (see SPEC.md §6.3) ───────────────────────────────────────────
# Dollars per UTC day across all models. At the cap the wizard closes and the
# site shows the gallery instead of an error.
DAILY_BUDGET_USD=15
# Opus is ~2x Sonnet, so it gets its own sub-budget inside the global one.
OPUS_DAILY_BUDGET_USD=5
# Flip to "1" to close the wizard immediately, regardless of spend.
KILL_SWITCH=0
# Submissions per visitor per UTC day (counted per IP hash AND per fingerprint).
DAILY_SUBMISSIONS_PER_VISITOR=3

# ─── Storage ─────────────────────────────────────────────────────────────────
# Pick ONE. First match wins: Postgres, then Supabase, then in-memory.
#
# Heroku sets DATABASE_URL for you when you attach Heroku Postgres, and the
# schema is created on first use — nothing to run by hand. This is also the
# option that makes spend caps survive a dyno restart, because spend is derived
# from the stored rows rather than a separate counter.
DATABASE_URL=
# Set to 1 only if your provider presents a verifiable certificate chain.
# Heroku Postgres does not, so leave this unset there.
PGSSL_STRICT=

# Alternative: Supabase, for serverless hosts like Vercel.
SUPABASE_URL=
# Service-role key. Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Only needed on serverless hosts, where instances share no memory. With
# DATABASE_URL set, quotas and spend are derived from stored rows instead and
# these can stay empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Bot control (optional — check is skipped if unset) ──────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Public origin ───────────────────────────────────────────────────────────
# Required in production. Share cards must be absolute URLs or no social
# scraper will fetch them, and copied case links use this too. On Heroku the
# app URL now has a random suffix — take the real one from `heroku apps:info`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Long random string. Required to open /admin.
ADMIN_TOKEN=

# ─── Privacy ─────────────────────────────────────────────────────────────────
# Salt for hashing visitor IPs. Set to any long random string; rotating it
# resets rate limits and unlinks past submissions from future ones.
IP_HASH_SALT=change-me-to-something-long-and-random
